{
  "name": "@nullix/zod-mongoose-studio",
  "version": "3.6.0",
  "description": "Monaco-powered TypeScript playground for @nullix/zod-mongoose",
  "main": "./nuxt.config.ts",
  "bin": {
    "zod-mongoose-studio": "./bin/index.mjs"
  },
  "homepage": "https://zodmongoose.com/studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harm-Nullix/zod-mongoose.git"
  },
  "bugs": {
    "url": "https://github.com/Harm-Nullix/zod-mongoose/issues/new"
  },
  "keywords": [
    "mongoose",
    "zod",
    "mongodb",
    "studio",
    "playground"
  ],
  "type": "module",
  "files": [
    "app",
    "server",
    "bin",
    "nuxt.config.ts",
    ".output"
  ],
  "author": "harm@nullix.nl",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:editor-types": "node scripts/generate-editor-types.mjs",
    "build": "nuxt build",
    "prepublishOnly": "pnpm run build",
    "dev": "nuxt dev -p 34003",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nullix/zod-mongoose": "workspace:*",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "get-port-please": "3.2.0",
    "mongoose": "9.11.4",
    "open": "11.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/ui": "4.12.0",
    "@types/node": "26.6.5",
    "monaco-editor": "0.57.0",
    "nuxt": "^4.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
