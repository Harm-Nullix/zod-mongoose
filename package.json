{
  "name": "@nullix/zod-mongoose-family",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "pnpm --filter \"*\" run lint",
    "lint:types:ts5": "pnpm --filter @nullix/zod-mongoose run lint:types:ts5",
    "lint:types:ts7": "pnpm --filter @nullix/zod-mongoose run lint:types:ts7",
    "test:types": "pnpm --filter @nullix/zod-mongoose run test:types",
    "test": "pnpm --filter \"*\" run test",
    "build": "pnpm --filter \"*\" --filter \"!docs\" run build",
    "dev": "pnpm --filter \"*playground*\" run dev",
    "release:prepare": "pnpm build && pnpm test && changeset && git add .changeset/",
    "release": "pnpm build && pnpm test && changeset publish --access public",
    "release:ci": "pnpm release --no-git-checks || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/compat": "2.0.3",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "eslint": "10.1.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "1.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-optimize-regex": "1.2.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-require-extensions": "0.1.3",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.57.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun",
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "remark-mdc": "patches/remark-mdc.patch"
    }
  }
}
