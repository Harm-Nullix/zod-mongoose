{
  "name": "@nullix/zod-mongoose-family",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "pnpm --filter \"*\" run lint",
    "lint:types:ts5": "pnpm --filter @nullix/zod-mongoose run lint:types:ts5",
    "lint:types:ts7": "pnpm --filter @nullix/zod-mongoose run lint:types:ts7",
    "test:types": "pnpm --filter @nullix/zod-mongoose run test:types",
    "test:coverage": "node scripts/generate-coverage.js",
    "test": "pnpm --filter \"*\" run test",
    "build": "pnpm --filter \"*\" --filter \"!docs\" run build",
    "dev": "pnpm --filter \"*playground*\" run dev",
    "release:prepare": "pnpm build && pnpm test && changeset && git add .changeset/",
    "release": "pnpm build && pnpm test && changeset publish",
    "release:ci": "pnpm release"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "bun": "1.4.3",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.13.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-optimize-regex": "1.2.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-require-extensions": "0.1.3",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/*": "^3.31.4"
    },
    "onlyBuiltDependencies": [
      "bun",
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "remark-mdc": "patches/remark-mdc.patch"
    }
  }
}
